{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "BIOSCAOUT Design System Tokens",
  "version": "3.0.0",
  "description": "Tokens de diseño del sistema de comando y control de enjambres tácticos BIOSCAOUT",
  "color": {
    "tactical": {
      "dark": { "value": "#060911", "comment": "Fondo principal de alto contraste táctico" },
      "panel": { "value": "#0b1220", "comment": "Superficie de paneles C2" },
      "elevated": { "value": "#111c30", "comment": "Superficies flotantes y tarjetas activas" },
      "border": { "value": "rgba(249, 115, 22, 0.18)", "comment": "Borde sutil naranja táctico" },
      "accent": { "value": "#f97316", "comment": "Acento de rescate y emergencia principal" },
      "cyan": { "value": "#38bdf8", "comment": "Señalización de telemetría y radar 2D/3D" },
      "alert": { "value": "#f43f5e", "comment": "Alerta crítica de impacto o fallo" },
      "warning": { "value": "#f59e0b", "comment": "Advertencia y batería baja" },
      "success": { "value": "#10b981", "comment": "Estado nominal, enlace conectado y rescate OK" },
      "rescue": { "value": "#ff6b1a", "comment": "Naranja de alta visibilidad médica SAR" }
    },
    "rescueScale": {
      "50": { "value": "#fff4ed" },
      "100": { "value": "#ffe6d5" },
      "200": { "value": "#ffc9aa" },
      "300": { "value": "#ffa371" },
      "400": { "value": "#ff7a3c" },
      "500": { "value": "#f97316" },
      "600": { "value": "#ea580c" },
      "700": { "value": "#c2410c" },
      "800": { "value": "#9a3412" },
      "900": { "value": "#7c2d12" },
      "950": { "value": "#431407" }
    },
    "lightMode": {
      "bgBase": { "value": "#f1f5f9" },
      "bgSurface": { "value": "#ffffff" },
      "bgSurfaceElevated": { "value": "#f8fafc" },
      "textPrimary": { "value": "#0f172a" },
      "border": { "value": "#cbd5e1" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": ["Plus Jakarta Sans", "system-ui", "sans-serif"] },
      "mono": { "value": ["JetBrains Mono", "monospace"] }
    },
    "letterSpacing": {
      "tactical": { "value": "-0.015em" }
    }
  },
  "shadows": {
    "glowCyan": { "value": "0 0 20px rgba(6, 182, 212, 0.25)" },
    "glowEmerald": { "value": "0 0 20px rgba(16, 185, 129, 0.25)" },
    "glowOrange": { "value": "0 0 20px rgba(249, 115, 22, 0.35)" },
    "glowAlert": { "value": "0 0 20px rgba(244, 63, 94, 0.35)" },
    "glass": { "value": "0 8px 32px 0 rgba(0, 0, 0, 0.37)" }
  },
  "animation": {
    "fadeIn": { "value": "fadeIn 0.4s ease-out forwards" },
    "slideUp": { "value": "slideUp 0.5s ease-out forwards" },
    "slideDown": { "value": "slideDown 0.5s ease-out forwards" },
    "scaleIn": { "value": "scaleIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards" },
    "shimmer": { "value": "shimmer 2s infinite linear" },
    "pulseGlow": { "value": "pulseGlow 2s infinite ease-in-out" },
    "float": { "value": "float 3s infinite ease-in-out" },
    "counterSpin": { "value": "counterSpin 0.5s ease-out forwards" },
    "breathe": { "value": "breathe 3s ease-in-out infinite" },
    "redGlowPulse": { "value": "redGlowPulse 2s ease-in-out infinite" }
  }
}
